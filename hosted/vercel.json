{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/app.mjs",
      "destination": "/public/app.mjs"
    },
    {
      "source": "/style.css",
      "destination": "/public/style.css"
    },
    {
      "source": "/api/build",
      "destination": "/api/build.py"
    },
    {
      "source": "/demo/:path*",
      "destination": "/api/index.mjs?route=demo/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.mjs?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/build.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "engine.zip"
        ]
      }
    }
  ]
}
